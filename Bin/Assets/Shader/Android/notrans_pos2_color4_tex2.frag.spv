#version 300 es
precision mediump float;
precision mediump sampler2D;

out vec4 outColor;

in vec4 fragColor;
in vec2 fragTexCoord;

uniform sampler2D texSampler0;

void main() 
{
    vec3 color = texture(texSampler0, fragTexCoord).xyz * fragColor.xyz;
    outColor = vec4(color, 1.0);
}